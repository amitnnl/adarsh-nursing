{
  "name": "project-college",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "build:export": "node -e \"process.env.NEXT_OUTPUT='export'; require('child_process').spawnSync('next', ['build'], { stdio: 'inherit', shell: true })\"",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "package:hostinger": "node scripts/generate-sql-dump.mjs && node scripts/create-hostinger-source-zip.mjs",
    "package:standalone": "node scripts/generate-sql-dump.mjs && node scripts/prepare-hostinger-bundle.mjs",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^13.4.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
